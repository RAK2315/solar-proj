import { cellGrid } from './data';
import { CRACK_POLYLINES, hotCells } from './panelCells';
import { PANEL_H, PANEL_W } from './scene';

type Point = readonly [number, number];

export interface GlassFragment {
  outline: readonly Point[];
  fractured: boolean;
}

/** The glass and heat share this transform; neither relies on box-face UVs. */
export function panelPoint(col: number, row: number): Point {
  return [(col / cellGrid.cols - 0.5) * PANEL_W, (row / cellGrid.rows - 0.5) * PANEL_H];
}

/**
 * Fracture geometry illustrates the declared fault. Its shape is authored, even
 * when its affected cells come from B-17's recorded thermal band.
 * The primary fracture follows the affected region. Branches may cross cold
 * glass: a visible glass fracture does not establish an electrical hot spot.
 */
export function fractureSpine(measured: boolean): Point[] {
  const divisions = cellGrid.cols * 2 + 1;
  const reference = measured ? hotCells(true, true) : [];
  const meanRow = reference.reduce((sum, c) => sum + c.row - 0.5, 0) / Math.max(1, reference.length);
  const path = CRACK_POLYLINES[0];
  return Array.from({ length: divisions + 1 }, (_, i) => {
    const x = cellGrid.cols * i / divisions;
    if (measured) return [x, meanRow + Math.sin(i * 2.1) * 0.16];
    const next = path.findIndex((p) => p[0] >= x);
    if (next <= 0) return [x, path[next < 0 ? path.length - 1 : 0][1]];
    const a = path[next - 1];
    const b = path[next];
    return [x, a[1] + (b[1] - a[1]) * (x - a[0]) / (b[0] - a[0])];
  });
}

export function panelFragments(cracked: boolean, measured: boolean): GlassFragment[] {
  const boundary: Point[] = [[0, 0], [cellGrid.cols, 0], [cellGrid.cols, cellGrid.rows], [0, cellGrid.rows]]
    .map(([x, y]) => panelPoint(x, y));
  if (!cracked) return [{
    fractured: false, outline: boundary,
  }];

  // Stable scatter avoids both reload-dependent damage and a cell-shaped stamp.
  // Smaller fragments gather around the affected region; the larger branches
  // continue through the cover glass without making those cells electrically hot.
  const sites: Point[] = Array.from({ length: 28 }, (_, i) => panelPoint(
    (((i + 1) * 0.61803398875) % 1) * cellGrid.cols,
    (((i + 1) * 0.41421356237 + 0.19) % 1) * cellGrid.rows,
  ));
  const spine = fractureSpine(measured).slice(4, -4);
  spine.forEach(([x, y], i) => {
    sites.push(panelPoint(x + Math.sin(i * 2.6) * 0.11, y - 0.22));
    sites.push(panelPoint(x + Math.cos(i * 3.1) * 0.12, y + 0.18));
  });
  return sites.map((site, i) => {
    let outline = boundary;
    sites.forEach((other, j) => {
      if (i === j) return;
      const normal: Point = [other[0] - site[0], other[1] - site[1]];
      const limit = ((site[0] + other[0]) * normal[0] + (site[1] + other[1]) * normal[1]) / 2;
      outline = clipPolygon(outline, normal, limit);
    });
    return { fractured: true, outline };
  });
}

/** Half-plane clipping keeps every shard convex and the glass inside its frame. */
function clipPolygon(polygon: readonly Point[], normal: Point, limit: number): Point[] {
  const out: Point[] = [];
  polygon.forEach((end, i) => {
    const start = polygon[(i + polygon.length - 1) % polygon.length];
    const a = start[0] * normal[0] + start[1] * normal[1] - limit;
    const b = end[0] * normal[0] + end[1] * normal[1] - limit;
    if ((a <= 0) !== (b <= 0)) {
      const k = a / (a - b);
      out.push([start[0] + (end[0] - start[0]) * k, start[1] + (end[1] - start[1]) * k]);
    }
    if (b <= 0) out.push(end);
  });
  return out;
}

interface SurfaceMesh { faces: number[]; bevels: number[] }

const GLASS_BOTTOM = 0.036;
const GLASS_TOP = 0.043;
const FRACTURE_GAP = 0.0015;
const BEVEL_WIDTH = 0.004;

/** A centreward inset cannot invert an acute shard or erase a small fragment. */
function insetPolygon(points: readonly Point[], distance: number): Point[] {
  const centre: Point = [
    points.reduce((sum, p) => sum + p[0], 0) / points.length,
    points.reduce((sum, p) => sum + p[1], 0) / points.length,
  ];
  const clearance = Math.min(...points.map((a, i) => {
    const b = points[(i + 1) % points.length];
    return Math.abs((b[0] - a[0]) * (centre[1] - a[1]) - (b[1] - a[1]) * (centre[0] - a[0]))
      / Math.hypot(b[0] - a[0], b[1] - a[1]);
  }));
  const amount = Math.min(0.32, distance / clearance);
  return points.map((p) => [p[0] + (centre[0] - p[0]) * amount, p[1] + (centre[1] - p[1]) * amount]);
}

/**
 * Separated glass prisms leave real gaps and sloped fracture walls above the
 * silicon. This is geometry, so highlights change with the inspection angle.
 */
export function glassMesh(fragments: readonly GlassFragment[]): SurfaceMesh {
  const faces: number[] = [];
  const bevels: number[] = [];
  const vertex = (p: Point, y: number) => [p[0], y, p[1]];
  for (const fragment of fragments) {
    const outer = insetPolygon(fragment.outline, fragment.fractured ? FRACTURE_GAP : 0);
    const top = insetPolygon(fragment.outline, fragment.fractured ? FRACTURE_GAP + BEVEL_WIDTH : 0);
    for (let i = 1; i < top.length - 1; i += 1) {
      faces.push(...vertex(top[0], GLASS_TOP), ...vertex(top[i + 1], GLASS_TOP), ...vertex(top[i], GLASS_TOP));
    }
    if (!fragment.fractured) continue;
    outer.forEach((p, i) => {
      const next = (i + 1) % outer.length;
      bevels.push(
        ...vertex(p, GLASS_BOTTOM), ...vertex(top[i], GLASS_TOP), ...vertex(top[next], GLASS_TOP),
        ...vertex(p, GLASS_BOTTOM), ...vertex(top[next], GLASS_TOP), ...vertex(outer[next], GLASS_BOTTOM),
      );
    });
  }
  return { faces, bevels };
}
