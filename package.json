{
  "name": "surya-agent",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/sync_artefacts.mjs && npm run pack:telemetry",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate:data": "tsx scripts/validate_data.ts",
    "check:literals": "node scripts/check_literals.mjs",
    "prebuild": "npm run sync:artefacts && npm run pack:telemetry && npm run validate:data && npm run check:literals && npm run test",
    "sync:artefacts": "node scripts/sync_artefacts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "shoot": "node scripts/shoot.mjs",
    "pack:telemetry": "tsx scripts/pack_telemetry.ts",
    "check:live": "node scripts/check_live.mjs",
    "demo": "node scripts/serve.mjs",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "check:layout": "node scripts/check_layout.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.544.0",
    "next": "15.5.22",
    "onnxruntime-web": "^1.19.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.3.1",
    "three": "^0.180.0",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4"
  }
}
